#!/bin/sh
# Runs INSIDE the container, as the first command scripts/guix-env starts
# (ADR-0004). Points everything that would write under HOME at .guix-env/
# in the repository instead, so it survives between container runs:
#
#   .guix-env/bin     the ocicl binary `make ocicl` builds
#   .guix-env/share   ocicl's runtime (XDG_DATA_HOME)
#   .guix-env/config  XDG_CONFIG_HOME
#   .guix-env/cache   ASDF's compiled fasls (XDG_CACHE_HOME), under
#                     manifest.scm (GUIX_ENV_MANIFEST unset, or naming it)
#
# Under another manifest, XDG_CACHE_HOME is instead
# .guix-env/cache-<that manifest's file name without .scm>, so two ECLs
# built differently never share fasls (M4 design §6.4; finding 9).
#
# It also sets CL_COMMONMARK_GFM_LIBS to the profile's exact pinned pair
# (ADR-0009: the library loads cmark-gfm from exactly these two absolute
# paths, never by bare name). And it puts the profile's lib/ on
# LD_LIBRARY_PATH, which now exists only for ocicl's libcrypto: Guix's
# glibc searches no FHS directory, so without it a CFFI load of libcrypto
# by bare name finds nothing.
set -eu

if [ -z "${GUIX_ENVIRONMENT:-}" ]; then
  echo "guix-env-enter: not inside a Guix environment; use scripts/guix-env" >&2
  exit 2
fi

state=$PWD/.guix-env

# scripts/guix-env already refused any value holding a /, so $manifest
# here is always a plain file name, with no directory component to strip.
manifest=${GUIX_ENV_MANIFEST:-manifest.scm}
case $manifest in
  manifest.scm) cache=$state/cache ;;
  *) cache=$state/cache-${manifest%.scm} ;;
esac

mkdir -p "$state/bin" "$state/share" "$state/config" "$cache"

export XDG_DATA_HOME="$state/share"
export XDG_CONFIG_HOME="$state/config"
export XDG_CACHE_HOME="$cache"
export OCICL_PREFIX="$state/"
export PATH="$state/bin:$PATH"
export LD_LIBRARY_PATH="$GUIX_ENVIRONMENT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# The pinned pair, by absolute path (ADR-0009). Each glob must match
# exactly one file; an unmatched glob stays literal in sh (word splitting
# does not break it apart, since it has no whitespace of its own), so it
# is simply a nonexistent path and matches zero files below.
#
# resolve_one GLOB -> prints the one matching regular file to stdout, or
# dies naming the glob and what it actually found.
resolve_one() {
  glob=$1
  n=0
  found=
  match=
  for f in $glob; do
    [ -f "$f" ] || continue
    match=$f
    found="$found$f "
    n=$((n + 1))
  done
  if [ "$n" -ne 1 ]; then
    echo "guix-env-enter: expected exactly one file matching $glob, found ${n} (${found:-none})" >&2
    exit 2
  fi
  echo "$match"
}

core=$(resolve_one "$GUIX_ENVIRONMENT"/lib/libcmark-gfm.so.'[0-9]*')
ext=$(resolve_one "$GUIX_ENVIRONMENT"/lib/libcmark-gfm-extensions.so.'[0-9]*')

export CL_COMMONMARK_GFM_LIBS="$core:$ext"

exec "$@"
